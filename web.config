<?xml version="1.0" encoding="utf-8"?>
<!-- Konfigurasi khusus site website RSBL; tidak mengubah site BPJS. -->
<configuration>
  <system.webServer>
    <!-- Halaman utama tetap memakai router query index.php?page=... tanpa URL Rewrite. -->
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.php" />
      </files>
    </defaultDocument>
    <directoryBrowse enabled="false" />
    <security>
      <requestFiltering>
        <!-- Batas total permintaan 128 MiB; batas per file tetap diperiksa PHP. -->
        <requestLimits maxAllowedContentLength="134217728" />
        <!-- Folder dan konfigurasi internal tidak boleh diakses melalui HTTP. -->
        <hiddenSegments>
          <remove segment="app" />
          <add segment="app" />
          <remove segment="views" />
          <add segment="views" />
          <remove segment="storage" />
          <add segment="storage" />
          <remove segment="docs" />
          <add segment="docs" />
          <remove segment="tests" />
          <add segment="tests" />
          <remove segment="tools" />
          <add segment="tools" />
          <remove segment="node_modules" />
          <add segment="node_modules" />
          <remove segment=".git" />
          <add segment=".git" />
          <remove segment=".agents" />
          <add segment=".agents" />
          <remove segment=".codex" />
          <add segment=".codex" />
          <remove segment=".aws" />
          <add segment=".aws" />
          <remove segment=".htaccess" />
          <add segment=".htaccess" />
          <remove segment=".user.ini" />
          <add segment=".user.ini" />
          <remove segment=".env" />
          <add segment=".env" />
          <remove segment=".editorconfig" />
          <add segment=".editorconfig" />
          <remove segment=".gitattributes" />
          <add segment=".gitattributes" />
          <remove segment=".gitignore" />
          <add segment=".gitignore" />
          <remove segment=".prettierignore" />
          <add segment=".prettierignore" />
          <remove segment=".prettierrc.json" />
          <add segment=".prettierrc.json" />
          <remove segment="config.php" />
          <add segment="config.php" />
          <remove segment="config.local.php" />
          <add segment="config.local.php" />
          <remove segment="router.php" />
          <add segment="router.php" />
          <remove segment="start.bat" />
          <add segment="start.bat" />
          <remove segment="package.json" />
          <add segment="package.json" />
          <remove segment="package-lock.json" />
          <add segment="package-lock.json" />
          <remove segment="requirements-dev.txt" />
          <add segment="requirements-dev.txt" />
          <remove segment="pyproject.toml" />
          <add segment="pyproject.toml" />
          <remove segment="README.md" />
          <add segment="README.md" />
          <remove segment="CHANGELOG.md" />
          <add segment="CHANGELOG.md" />
          <remove segment="HASIL-PENGUJIAN.md" />
          <add segment="HASIL-PENGUJIAN.md" />
          <remove segment="MULAI-DI-SINI.txt" />
          <add segment="MULAI-DI-SINI.txt" />
        </hiddenSegments>
        <!-- Hanya ekstensi halaman dan aset publik yang dapat dilayani. -->
        <fileExtensions allowUnlisted="false">
          <!-- Izinkan alamat tanpa ekstensi seperti / agar defaultDocument bisa dijalankan. -->
          <remove fileExtension="." />
          <add fileExtension="." allowed="true" />
          <remove fileExtension=".php" />
          <add fileExtension=".php" allowed="true" />
          <remove fileExtension=".css" />
          <add fileExtension=".css" allowed="true" />
          <remove fileExtension=".js" />
          <add fileExtension=".js" allowed="true" />
          <remove fileExtension=".svg" />
          <add fileExtension=".svg" allowed="true" />
          <remove fileExtension=".png" />
          <add fileExtension=".png" allowed="true" />
          <remove fileExtension=".jpg" />
          <add fileExtension=".jpg" allowed="true" />
          <remove fileExtension=".jpeg" />
          <add fileExtension=".jpeg" allowed="true" />
          <remove fileExtension=".webp" />
          <add fileExtension=".webp" allowed="true" />
          <remove fileExtension=".avif" />
          <add fileExtension=".avif" allowed="true" />
          <remove fileExtension=".ico" />
          <add fileExtension=".ico" allowed="true" />
          <remove fileExtension=".mp4" />
          <add fileExtension=".mp4" allowed="true" />
          <remove fileExtension=".webm" />
          <add fileExtension=".webm" allowed="true" />
        </fileExtensions>
      </requestFiltering>
    </security>
    <!-- Remove dahulu agar tidak duplikat dengan MIME bawaan IIS. -->
    <staticContent>
      <remove fileExtension=".avif" />
      <mimeMap fileExtension=".avif" mimeType="image/avif" />
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
      <remove fileExtension=".mp4" />
      <mimeMap fileExtension=".mp4" mimeType="video/mp4" />
      <remove fileExtension=".webm" />
      <mimeMap fileExtension=".webm" mimeType="video/webm" />
    </staticContent>
  </system.webServer>
  <!-- File PHP tidak boleh dieksekusi dari folder aset, termasuk unggahan. -->
  <location path="assets">
    <system.webServer>
      <security>
        <requestFiltering>
          <fileExtensions>
            <remove fileExtension=".php" />
            <add fileExtension=".php" allowed="false" />
          </fileExtensions>
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
